# Contraseña para entrar al panel
ADMIN_PASSWORD=
# Cadena larga y aleatoria para firmar la sesión del panel
SESSION_SECRET=
# URL pública del sitio (para links absolutos, OG y sitemap)
NEXT_PUBLIC_SITE_URL=https://www.loscazadoresdenoticias.com

# Importar publicaciones de Instagram y Facebook (pantalla Redes del panel).
# Salen de developers.facebook.com, en Configuración de la app, Básica.
META_APP_ID=
META_APP_SECRET=
# Opcional: clave para disparar la importación desde un cron externo (ruta /api/sync).
CRON_SECRET=
# Opcional: carpeta de datos fuera del proyecto, por ejemplo un disco persistente.
DATA_DIR=

# Solo para pruebas locales: hosts a los que se puede descargar aunque sean internos o http.
# PERMITIR_HOSTS_LOCALES=

# Vercel: las definen solas las integraciones de Neon (Postgres) y Blob al conectarlas al proyecto.
# Sin DATABASE_URL el sitio guarda todo en archivos (data/), que es lo que se usa en tu computadora.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Estadísticas (opcional). STATS_SALT es la clave con la que se arma el código anónimo diario de cada visitante;
# si no está se usa SESSION_SECRET. ESTADISTICAS=off apaga el conteo.
# STATS_SALT=
# ESTADISTICAS=off

# Opcional: forzar archivos aunque haya DATABASE_URL (ALMACEN=archivo), y cuántas conexiones abre cada instancia.
# ALMACEN=
# PGPOOL_MAX=3
